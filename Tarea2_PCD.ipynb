            "DatasetDict({\n",
            "    train: Dataset({\n",
            "        features: ['label', 'text'],\n",
            "        num_rows: 650000\n",
            "    })\n",
            "    test: Dataset({\n",
            "        features: ['label', 'text'],\n",
            "        num_rows: 50000\n",
            "    })\n",
            "})\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "train_set = dataset[\"train\"].shuffle(seed=42).select(range(2000))\n",
        "test_set = dataset[\"test\"].shuffle(seed=42).select(range(500))"
      ],
      "metadata": {
        "id": "qh8MgydAz99f"
      },
      "execution_count": 5,
      "outputs": []
